{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Klam approved source registry",
  "type": "object",
  "required": [
    "source_id",
    "title",
    "source_url",
    "source_version",
    "rights_basis",
    "rights_status",
    "license",
    "license_url",
    "rights_evidence_url",
    "attribution"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "source_version": {"type": "string", "minLength": 1},
    "rights_basis": {"enum": ["original", "contributor_permission", "public_domain"]},
    "rights_status": {"enum": ["candidate", "pending", "approved", "rejected"]},
    "license": {"enum": ["CC-BY-4.0", "Public-Domain"]},
    "license_url": {"type": "string"},
    "rights_evidence_url": {"type": "string", "format": "uri"},
    "attribution": {"type": "string", "minLength": 1},
    "permission_evidence_recorded": {"type": "boolean"},
    "permission_form_version": {"type": "string"},
    "accessed_at": {"type": "string", "format": "date"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "rights_basis": {"enum": ["original", "contributor_permission"]}
        },
        "required": ["rights_basis"]
      },
      "then": {
        "properties": {
          "license": {"const": "CC-BY-4.0"},
          "license_url": {"const": "https://creativecommons.org/licenses/by/4.0/"},
          "permission_evidence_recorded": {"const": true}
        },
        "required": ["permission_evidence_recorded"]
      }
    },
    {
      "if": {
        "properties": {"rights_basis": {"const": "public_domain"}},
        "required": ["rights_basis"]
      },
      "then": {
        "properties": {"license": {"const": "Public-Domain"}}
      }
    }
  ],
  "additionalProperties": false
}
