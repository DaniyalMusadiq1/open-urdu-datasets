{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "urdu",
    "roman",
    "english",
    "pos",
    "example",
    "source",
    "license",
    "review_status",
    "attestations"
  ],
  "properties": {
    "urdu": {
      "type": "string",
      "minLength": 1
    },
    "roman": {
      "type": "string",
      "minLength": 1
    },
    "english": {
      "type": [
        "string",
        "null"
      ]
    },
    "pos": {
      "type": [
        "string",
        "null"
      ]
    },
    "example": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "url",
        "version",
        "member",
        "line",
        "upstream_sha256"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string"
        },
        "member": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "upstream_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "license": {
      "const": "CC-BY-SA-4.0"
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "verified"
      ]
    },
    "attestations": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
