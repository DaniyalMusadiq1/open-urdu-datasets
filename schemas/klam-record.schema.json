{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Klam normalized Urdu record",
  "type": "object",
  "required": [
    "id",
    "title",
    "text",
    "language",
    "script",
    "task",
    "label",
    "split",
    "source_id",
    "source_version",
    "source_record_id",
    "source_locator",
    "rights_basis",
    "license",
    "license_url",
    "rights_evidence_url",
    "attribution",
    "review_status",
    "reviewer_id",
    "review_date",
    "review_scope"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "const": "ur"
    },
    "script": {
      "enum": [
        "Arabic",
        "Latin",
        "Mixed"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "string"
    },
    "rights_basis": {
      "enum": [
        "original",
        "contributor_permission",
        "public_domain",
        "cc0",
        "cc_by",
        "cc_by_2_fr",
        "cc_by_sa"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "license_url": {
      "type": "string"
    },
    "rights_evidence_url": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "human_reviewed"
      ]
    },
    "reviewer_id": {
      "type": "string"
    },
    "review_date": {
      "type": "string"
    },
    "review_scope": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "paired_text": {
      "type": "string",
      "minLength": 1
    },
    "paired_script": {
      "enum": [
        "Arabic",
        "Latin",
        "Mixed"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task": {
            "const": "transliteration_pair"
          }
        },
        "required": [
          "task"
        ]
      },
      "then": {
        "required": [
          "paired_text",
          "paired_script"
        ]
      }
    },
    {
      "if": {
        "required": [
          "paired_text"
        ]
      },
      "then": {
        "required": [
          "paired_script"
        ]
      }
    }
  ],
  "additionalProperties": false
}

