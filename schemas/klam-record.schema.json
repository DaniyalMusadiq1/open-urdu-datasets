{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Klam normalized Urdu record",
  "type": "object",
  "required": [
    "id",
    "text",
    "language",
    "script",
    "task",
    "label",
    "split",
    "source_id",
    "source_version",
    "source_record_id",
    "source_locator",
    "rights_basis",
    "license",
    "license_url",
    "rights_evidence_url",
    "attribution",
    "review_status",
    "reviewer_id",
    "review_date",
    "review_scope"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "language": {"const": "ur"},
    "script": {"enum": ["Arabic", "Latin", "Mixed"]},
    "task": {"type": "string", "minLength": 1},
    "label": {"type": "string"},
    "split": {"type": "string"},
    "source_id": {"type": "string", "minLength": 1},
    "source_version": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "source_locator": {"type": "string"},
    "rights_basis": {"enum": ["original", "contributor_permission", "public_domain"]},
    "license": {"type": "string", "minLength": 1},
    "license_url": {"type": "string"},
    "rights_evidence_url": {"type": "string", "minLength": 1},
    "attribution": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["unreviewed", "human_reviewed"]},
    "reviewer_id": {"type": "string"},
    "review_date": {"type": "string"},
    "review_scope": {"type": "string"}
  },
  "additionalProperties": false
}
